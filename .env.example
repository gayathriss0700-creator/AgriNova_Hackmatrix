# ============================================================
# AgriNova - Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ── AI Chat & Transcription ──────────────────────────────────
# Groq (FREE) — Get key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI (Paid fallback) — Get key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Anthropic (Paid fallback)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Supabase ─────────────────────────────────────────────────
# Get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_MOCK_SUPABASE=true

# ── ML Backend ───────────────────────────────────────────────
ML_BACKEND_URL=http://localhost:8000

# ── Gemini (for satellite advice - optional) ─────────────────
# GEMINI_API_KEY=your-gemini-key-here

# ── News API (optional) ──────────────────────────────────────
# NEWS_API_KEY=your-gnews-key-here

# ── Sentinel Hub (optional - for real satellite imagery) ─────
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# ── HuggingFace (optional) ───────────────────────────────────
# HF_TOKEN=
